# Copy to .env for local development. Never commit .env.

PORT=8080

# Google accounts allowed to sign in, comma-separated. Empty = nobody.
ALLOWED_EMAILS=you@example.com

# Firebase web app config (Firebase console > Project settings > Your apps). Public values.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project

# Server credentials for Firestore, Firebase Auth and the Merchant API.
# On Cloud Run leave this unset: the service's own service account is used.
# Anywhere else: full path to a service account key file kept OUTSIDE this folder.
GOOGLE_APPLICATION_CREDENTIALS=

# Secrets
WHOP_API_KEY=
ANTHROPIC_API_KEY=

# Optional
CLAUDE_MODEL=claude-opus-5-5
