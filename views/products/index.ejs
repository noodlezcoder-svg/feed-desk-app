<%- include('../partials/head', { title: 'Products' }) %>
<div class="bar">
  <h1>Products</h1>
  <form method="post" action="/products/import" data-busy="Importing…">
    <button type="submit" class="primary">Import from Whop</button>
  </form>
</div>

<nav class="chips">
  <a href="/" class="<%= status ? '' : 'on' %>">All <span><%= counts.all %></span></a>
  <% statuses.forEach(function (s) { %>
    <a href="/?status=<%= s %>" class="<%= status === s ? 'on' : '' %>"><%= s %> <span><%= counts[s] %></span></a>
  <% }) %>
</nav>

<% if (!products.length) { %>
  <section class="card">
    <p class="muted">No products here yet. Fill in Settings, then use <b>Import from Whop</b>.</p>
  </section>
<% } else { %>
  <table class="list">
    <thead>
      <tr><th>Product</th><th>Price</th><th>On Whop</th><th>Status</th><th>Google</th><th>Updated</th></tr>
    </thead>
    <tbody>
      <% products.forEach(function (p) { %>
        <tr>
          <td>
            <a href="/products/<%= encodeURIComponent(p.id) %>"><%= (p.feed && p.feed.title) || p.source.productTitle %></a>
            <% if (p.source.variantTitle) { %><div class="muted small"><%= p.source.variantTitle %></div><% } %>
          </td>
          <td><%= p.source.price %> <%= p.source.currency %></td>
          <td class="small">
            <%= p.source.visible ? 'visible' : 'hidden' %> · <%= p.source.inStock ? 'in stock' : 'out of stock' %>
          </td>
          <td><span class="badge s-<%= p.status %>"><%= p.status %></span></td>
          <td class="small">
            <%= p.gmc.state.replace('_', ' ') %><% if (p.gmc.issues.length) { %> · <%= p.gmc.issues.length %> issue(s)<% } %>
          </td>
          <td class="small muted"><%= p.updatedAt.slice(0, 16).replace('T', ' ') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (products.length === 200) { %><p class="muted small">Showing the 200 most recent. Filter by status to see others.</p><% } %>
<% } %>
<%- include('../partials/foot') %>
